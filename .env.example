FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
FOUNDRY_DEPLOYMENT=fast-decider
SLOW_MODEL=slow-reasoner
BENCHMARK_NETWORK=presentation network
# Authentication uses your existing az login; no keys are required.
# STUB=1
# BRAKE_DECEL_MPS2=1.5
# Known low-risk contacts slow toward this speed, rather than emergency stopping.
# Gentle deceleration is capped at BRAKE_DECEL_MPS2.
# GENTLE_DECEL_MPS2=3
# GENTLE_SPEED_KMH=50
# ACCEL_MPS2=2.0
# Staged encounters and continuous Rear threats; restart after edits.
# Try 80 for a short-warning rear threat.
# INITIAL_HAZARD_DISTANCE_M=500
# Rear threat only; initial follower gap, not reset between hazards. Restart after edits.
# FOLLOWING_VEHICLE_DISTANCE_M=80
# Continuous driving is live-only and makes paid model calls after Start.
# DRIVE_SEED=42
# 0 means until Stop; collisions still pause for inspection.
# DRIVE_DURATION_S=120
# Base quiet interval; initial/subsequent gaps randomize to 85-115%, rounded up to ticks.
# DRIVE_GAP_S=3
# DRIVE_DWELL_S=3
