{
  "name": "fast-slow-decision-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "npm run build && node --test",
    "benchmark": "npm run build && node --env-file-if-exists=.env dist/scripts/benchmark.js",
    "record": "npm run build && node --env-file-if-exists=.env dist/scripts/record-fixtures.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "openai": "^7.32.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
